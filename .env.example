# Base URL of the resale-admin API (public / browser-visible)
NEXT_PUBLIC_API_BASE_URL=https://your-admin-host/api/v1

# Google key for Places (New) + Distance Matrix + Maps JavaScript APIs.
# Server-only — do NOT add a NEXT_PUBLIC_ prefix. Optional: without it the map
# falls back to OpenStreetMap and locality data falls back to curated values.
GOOGLE_PLACES_API_KEY=your-google-maps-key

# Google Sign-In (Identity Services) — must be the SAME OAuth 2.0 Web
# application Client ID the resale-admin backend has as its GOOGLE_CLIENT_ID
# (it verifies the ID token's audience against that value). This one must be
# NEXT_PUBLIC since Google Identity Services runs in the browser. Optional:
# without it, the "Continue with Google" button just doesn't render.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Anthropic API key for the header's "AI Search" assistant (logged-in users
# only). Server-only — do NOT add a NEXT_PUBLIC_ prefix; it's read exclusively
# by app/api/ai/chat/route.ts, a server-side Route Handler, and never reaches
# the browser. Without it, the endpoint returns 503 and the panel shows an error.
ANTHROPIC_API_KEY=your-anthropic-api-key
