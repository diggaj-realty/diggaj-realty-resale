# Base URL of the resale-admin API (public / browser-visible)
NEXT_PUBLIC_API_BASE_URL=https://your-admin-host/api/v1

# Google key for Places (New) + Distance Matrix + Maps JavaScript APIs.
# Server-only — do NOT add a NEXT_PUBLIC_ prefix. Optional: without it the map
# falls back to OpenStreetMap and locality data falls back to curated values.
GOOGLE_PLACES_API_KEY=your-google-maps-key
