# Base URL of the resale-admin API (public / browser-visible)
NEXT_PUBLIC_API_BASE_URL=https://your-admin-host/api/v1

# Google key for Places (New) + Distance Matrix + Maps JavaScript APIs.
# Server-only — do NOT add a NEXT_PUBLIC_ prefix. Optional: without it the map
# falls back to OpenStreetMap and locality data falls back to curated values.
GOOGLE_PLACES_API_KEY=your-google-maps-key

# Google Sign-In (Identity Services) — must be the SAME OAuth 2.0 Web
# application Client ID the resale-admin backend has as its GOOGLE_CLIENT_ID
# (it verifies the ID token's audience against that value). This one must be
# NEXT_PUBLIC since Google Identity Services runs in the browser. Optional:
# without it, the "Continue with Google" button just doesn't render.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Anthropic API key for the header's "AI Search" assistant (logged-in users
# only). Server-only — do NOT add a NEXT_PUBLIC_ prefix; it's read exclusively
# by app/api/ai/chat/route.ts, a server-side Route Handler, and never reaches
# the browser. Without it, the endpoint returns 503 and the panel shows an error.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Resend (https://resend.com) — sends the contact/lead form (LeadForm.tsx) via
# app/api/leads/route.ts. Server-only. Without it, that route returns 503 and
# the form shows a "not configured yet" error instead of crashing.
RESEND_API_KEY=your-resend-api-key
# Must be on a domain verified in your Resend account — until then, Resend's
# own onboarding@resend.dev sender works for testing (limited deliverability).
LEAD_FROM_EMAIL="Diggaj Realty <onboarding@resend.dev>"
# Inbox that receives lead notifications.
LEAD_TO_EMAIL=hello@diggajrealty.com

# Separate Resend key/inbox for the Brigade Granada microsite's lead capture
# (app/api/leads/brigade-granada/route.ts) — scoped to that project only, kept
# apart from the general RESEND_API_KEY above.
BRIGADE_GRANADA_RESEND_API_KEY=your-resend-api-key
# Comma-separated list of recipients.
BRIGADE_GRANADA_LEAD_TO_EMAIL=it@diggajrealty.com,abhishek@diggajrealty.com

# Same pattern for the Sobha One World Hoskote microsite
# (app/api/leads/sobha-one-world-hoskote/route.ts).
SOBHA_ONE_WORLD_RESEND_API_KEY=your-resend-api-key
SOBHA_ONE_WORLD_LEAD_TO_EMAIL=it@diggajrealty.com,abhishek@diggajrealty.com

# Same pattern for the Myhna Vistara microsite (app/api/leads/myhna-vistara/route.ts).
MYHNA_VISTARA_RESEND_API_KEY=your-resend-api-key
MYHNA_VISTARA_LEAD_TO_EMAIL=it@diggajrealty.com,abhishek@diggajrealty.com

# WhatsApp Business contact button (components/WhatsAppButton.tsx). Digits
# only, country code, no + or spaces (e.g. 919876543210). Public — it's a
# plain wa.me link, not a secret. Falls back to a placeholder number until set.
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Real social profile URLs for the footer (components/Footer.tsx). Public.
# Each falls back to a generic placeholder domain until set.
NEXT_PUBLIC_SOCIAL_X=https://x.com/your-handle
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://facebook.com/your-page
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://linkedin.com/company/your-company
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/your-handle
NEXT_PUBLIC_SOCIAL_YOUTUBE=https://youtube.com/@your-channel
